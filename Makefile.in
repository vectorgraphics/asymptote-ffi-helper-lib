# -*- tab-width: 4; indent-tabs-mode: t; -*-

CXX=@CXX@
CXXFLAGS=-std=c++20 -MMD -Iinclude -Iasyffi_header -fPIC @CXXFLAGS@
LDFLAGS=@LDFLAGS@
VPATH=src examples
SUFFIXES += .d

DOXYGEN=@DOXYGEN@

SRCFILES = \
	contextFuncs functions item threads typeObjs \
	types pen structs

# examples

EXAMPLES = threadSample

DEPS = $(addsuffix .d,$(SRCFILES) $(EXAMPLES))

default: libasyffi_helper.a
.PHONY: default

all: libasyffi_helper.a examples $(DOCS)
.PHONY: default

libasyffi_helper.a: $(addsuffix .o,$(SRCFILES))
	rm -f $@ && ar rcs $@ $^

%.o: %.cc
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# examples


lib%.so: %.o libasyffi_helper.a
	$(CXX) -shared  $< -o $@ $(LDFLAGS) -L. -l asyffi_helper

.PHONY: examples
examples: $(addsuffix .so,$(addprefix lib,$(EXAMPLES)))

# clean/dist-clean options

.PHONY: clean
clean:
	rm -rf *.so *.o *.a *.exe *.d docs

.PHONY: distclean
distclean: clean
	rm -rf asyffi_header Makefile \
		configure config.log config.status configure~ autom4te.cache

Makefile: Makefile.in config.status
	./config.status

ifneq ($(DOXYGEN),)
DOCS += docs/html/index.html
endif

docs: $(DOCS)
ifeq ($(DOXYGEN),)
	$(error doxygen not present)
endif

docs/html/index.html: Doxyfile $(wildcard include/**/*.h)
ifneq ($(DOXYGEN),)
	$(DOXYGEN) Doxyfile
else
	$(error doxygen not present)
endif

config.status:

ifeq (,$(filter clean distclean,$(MAKECMDGOALS)))
-include $(DEPS)
endif
